# ============================================================
# Project Atlas - Environment Configuration
# ============================================================
#
# IMPORTANT:
# - This file contains placeholders only.
# - NEVER put real secrets/API keys in this file.
# - Copy this file to .env for local development:
#
#     Copy-Item .env.example .env
#
# The .env file is ignored by Git.
# ============================================================


# ============================================================
# Application
# ============================================================

APP_NAME=project-atlas
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

LOG_LEVEL=INFO


# ============================================================
# PostgreSQL
# ============================================================
#
# Free and open-source.
# Used for application metadata, jobs, users, audit records,
# source configuration, processing state, etc.
#

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://atlas:change-me@localhost:5432/atlas


# ============================================================
# Neo4j
# ============================================================
#
# Neo4j Community Edition can be used locally for free.
# Used for Atlas knowledge graph.
#

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j


# ============================================================
# Qdrant
# ============================================================
#
# Qdrant can be self-hosted locally for free.
# Used for vector storage and semantic retrieval.
#

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ============================================================
# MinIO
# ============================================================
#
# S3-compatible object storage.
# Free/self-hosted for development.
#
# Used for:
# - raw documents
# - processed documents
# - extracted artifacts
# - exports
#

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=atlas
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET_RAW=atlas-raw
MINIO_BUCKET_PROCESSED=atlas-processed
MINIO_BUCKET_EXPORTS=atlas-exports


# ============================================================
# Kafka
# ============================================================
#
# Apache Kafka is open source and can be run locally.
# Used for event streaming between Atlas components.
#

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_CLIENT_ID=atlas
KAFKA_GROUP_ID=atlas-workers

KAFKA_SECURITY_PROTOCOL=PLAINTEXT


# ============================================================
# Temporal
# ============================================================
#
# Temporal can be self-hosted locally for development.
# Used for durable workflow orchestration.
#

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=atlas-task-queue


# ============================================================
# LLM Gateway
# ============================================================
#
# Atlas should NOT directly depend on one LLM provider.
#
# Development:
# - Prefer a local/free model where practical.
#
# Production:
# - Company may configure OpenAI, Anthropic, Gemini,
#   Azure OpenAI, or another approved provider.
#
# LiteLLM will act as the provider abstraction layer.
#

LLM_PROVIDER=local
LLM_MODEL=
LLM_API_KEY=

LLM_BASE_URL=


# ============================================================
# Embeddings
# ============================================================
#
# Development can use a local open-source embedding model.
# Production can use a company-approved hosted model if required.
#

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=


# ============================================================
# OCR
# ============================================================
#
# Development:
# - Tesseract OCR can be used locally for free.
#
# Production:
# - A commercial OCR provider can be configured later if needed.
#

OCR_PROVIDER=tesseract


# ============================================================
# Authentication
# ============================================================

AUTH_ENABLED=true

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# CORS
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000


# ============================================================
# Observability
# ============================================================
#
# Langfuse can be self-hosted for development.
#

LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ============================================================
# Metrics / Tracing
# ============================================================

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# ============================================================
# Web Crawling
# ============================================================

CRAWLER_PROVIDER=crawl4ai

CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_CONCURRENT_REQUESTS=5


# ============================================================
# File Processing
# ============================================================

MAX_FILE_SIZE_MB=100

SUPPORTED_DOCUMENT_TYPES=pdf,docx,pptx,xlsx,csv,xml,json,html,md,eml,txt,image,zip


# ============================================================
# Processing
# ============================================================

PROCESSING_MAX_RETRIES=3

PROCESSING_TIMEOUT_SECONDS=3600

PROCESSING_BATCH_SIZE=100


# ============================================================
# Chunking
# ============================================================

CHUNK_SIZE=1000
CHUNK_OVERLAP=150


# ============================================================
# Environment Flags
# ============================================================

ENABLE_KAFKA=true
ENABLE_TEMPORAL=true
ENABLE_NEO4J=true
ENABLE_QDRANT=true
ENABLE_MINIO=true
ENABLE_OCR=true
ENABLE_LLM=true